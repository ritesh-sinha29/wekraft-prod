# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AGENT_URL=http://localhost:8000

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Convex
# CONVEX_DEPLOYMENT is created by `pnpm convex dev`.
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Set this in the Convex deployment environment as well.
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

# Turso
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# S3-compatible object storage
# Keep the existing AWS_ACCES_KEY spelling; it is the name used by the app.
AWS_ACCES_KEY=your_access_key_id
AWS_SECRET_KEY_S3=your_secret_access_key

# Email (SMTP and Resend)
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL=notifications@example.com
RESEND_API_KEY=re_your_resend_api_key
RESEND_INVITE_TEMPLATE_ID=your_resend_template_id

# AI
OPENAI_API_KEY=sk-your_openai_api_key
# Compatibility alias used by some deployments; current app code reads OPENAI_API_KEY.
OPENAI_KEY=sk-your_openai_api_key

# Realtime messaging
ABLY_API_KEY=your_ably_api_key

# Stream video
NEXT_PUBLIC_STREAM_API_KEY=your_stream_api_key
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_PLUS_PLAN_ID=plan_your_plus_plan_id
RAZORPAY_PRO_PLAN_ID=plan_your_pro_plan_id
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Lemon Squeezy
LEMONSQUEEZY_API_KEY=your_lemonsqueezy_api_key
LEMONSQUEEZY_STORE_ID=your_store_id
LEMONSQUEEZY_PLUS_VARIANT_ID=your_plus_variant_id
LEMONSQUEEZY_PRO_VARIANT_ID=your_pro_variant_id
LEMONSQUEEZY_WEBHOOK_SECRET=your_lemonsqueezy_webhook_secret

# Server-to-Convex authentication and encryption
# Generate independent high-entropy values; do not reuse these placeholders.
BACKEND_SECRET=generate_a_random_64_character_secret
DB_ENCRYPTION_KEY=generate_a_random_32_byte_key
BLIND_INDEX_SALT=generate_a_random_salt

# GitHub webhook development URL
WEBHOOK_URL_NGROK=https://your-subdomain.ngrok-free.app/api/webhooks/github

# Optional: required only when uploading Sentry source maps during builds.
SENTRY_AUTH_TOKEN=your_sentry_auth_token
